<?php
    // Connessione DB
    $host = "db";
    $db_name = "android_db";
    $username = "user";
    $password = "user";

    try {
        $conn = new PDO("mysql:host=$host;dbname=$db_name", $username, $password);
        $conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    } catch(PDOException $e) {
        echo "Errore connessione: " . $e->getMessage();
}
?>